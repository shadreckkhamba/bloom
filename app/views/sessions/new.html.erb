<div class="auth-split-page">
  <!-- Left: photo panel -->
  <div class="auth-split-photo" aria-hidden="true">
    <%= image_tag "DEL00554_web.jpg", alt: "", class: "auth-split-img" %>
    <div class="auth-split-photo-overlay">
      <p class="auth-split-brand"><%= app_name %> 🌸</p>
      <p class="auth-split-tagline">Your love story, beautifully managed.</p>
    </div>
  </div>
  <!-- Right: form panel -->
  <div class="auth-split-form">
    <div class="auth-split-inner">
      <div class="text-center mb-4">
        <h1 class="text-gold d-lg-none" style="font-size:1.8rem;"><%= app_name %></h1>
        <p class="text-muted small">🌸 Private wedding invitations</p>
      </div>
      <div class="auth-card">
        <h2 class="mb-4" style="font-size:1.5rem;">Welcome back</h2>
        <%= form_with url: login_path, data: { turbo: false } do |f| %>
          <div class="mb-3">
            <%= f.label :username, "Username", class: "form-label small text-muted" %>
            <%= f.text_field :username, class: "form-control", autofocus: true, required: true,
                  autocomplete: "username", autocapitalize: "none", spellcheck: "false" %>
          </div>
          <div class="mb-4">
            <%= f.label :password, "Password", class: "form-label small text-muted" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>
          <%= f.submit "Sign in", class: "btn btn-bloom w-100" %>
        <% end %>
      </div>
      <p class="text-center mt-3 small text-muted">
        Don't have an account? <%= link_to "Create one", signup_path, class: "text-gold" %>
      </p>
    </div>
  </div>
</div>

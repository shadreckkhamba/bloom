<div class="auth-split-page">
  <!-- Left: photo panel -->
  <div class="auth-split-photo" aria-hidden="true">
    <%= image_tag "DEL00564.jpg.jpeg", alt: "", class: "auth-split-img" %>
    <div class="auth-split-photo-overlay">
      <p class="auth-split-brand"><%= app_name %> 🌸</p>
      <p class="auth-split-tagline">Your love story, beautifully managed.</p>
    </div>
  </div>
  <!-- Right: form panel -->
  <div class="auth-split-form">
    <div class="auth-split-inner">
      <div class="text-center mb-4">
        <h1 class="text-gold d-lg-none" style="font-size:1.8rem;"><%= app_name %></h1>
        <% if @partner_token.present? %>
          <p class="text-muted small">💍 Create your account to join the wedding</p>
        <% else %>
          <p class="text-muted small">🌸 Create your account</p>
        <% end %>
      </div>
      <div class="auth-card">
        <h2 class="mb-4" style="font-size:1.5rem;">Get started</h2>
        <%= form_with model: @user, url: signup_path(partner_token: @partner_token), data: { turbo: false } do |f| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger small">
              <%= @user.errors.full_messages.first %>
            </div>
          <% end %>
          <% if @partner_token.present? %>
            <input type="hidden" name="partner_token" value="<%= @partner_token %>">
          <% end %>
          <div class="mb-3">
            <%= f.label :name, "Your name", class: "form-label small text-muted" %>
            <%= f.text_field :name, class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :username, "Username", class: "form-label small text-muted" %>
            <%= f.text_field :username, class: "form-control", required: true,
                  autocomplete: "username", autocapitalize: "none", spellcheck: "false",
                  placeholder: "e.g. amina_kelvin" %>
            <div class="form-text text-muted" style="font-size:0.75rem;">Letters, numbers, underscores, hyphens, dots. 3–30 characters.</div>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Password", class: "form-label small text-muted" %>
            <%= f.password_field :password, class: "form-control", required: true, minlength: 8 %>
          </div>
          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirm password", class: "form-label small text-muted" %>
            <%= f.password_field :password_confirmation, class: "form-control", required: true %>
          </div>
          <%= f.submit "Create account", class: "btn btn-bloom w-100" %>
        <% end %>
      </div>
      <p class="text-center mt-3 small text-muted">
        Already have an account? <%= link_to "Sign in", login_path(partner_token: @partner_token), class: "text-gold" %>
      </p>
    </div>
  </div>
</div>
